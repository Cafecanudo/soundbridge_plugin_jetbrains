<idea-plugin>
    <id>com.soundbridge.plugin</id>
    <name>SoundBridge — Enviar por Áudio</name>
    <vendor email="cafecanudo@gmail.com" url="https://github.com/Cafecanudo">SoundBridge</vendor>

    <description><![CDATA[
        Transmite arquivos por áudio direto da IDE, usando o SoundBridge TX (soundbridge-tx).
        Clique com o botão direito num arquivo do projeto e escolha "Enviar por Áudio".
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
                parentId="tools"
                instance="com.soundbridge.plugin.SettingsConfigurable"
                id="com.soundbridge.plugin.settings"
                displayName="SoundBridge"/>
    </extensions>

    <actions>
        <action id="com.soundbridge.plugin.SendByAudioAction"
                class="com.soundbridge.plugin.SendByAudioAction"
                text="Soundbridge TX"
                description="Transmite o arquivo por áudio via SoundBridge TX">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="com.soundbridge.plugin.SendTextByAudioAction"
                class="com.soundbridge.plugin.SendTextByAudioAction"
                text="Soundbridge TX"
                description="Transmite o texto selecionado por áudio via SoundBridge TX">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
